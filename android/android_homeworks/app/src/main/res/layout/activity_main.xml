<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView: all the homework buttons no longer fit on one screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:orientation="vertical">

    <EditText
        android:id="@+id/firstNumberInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/first_number_hint"
        android:inputType="numberDecimal|numberSigned" />

    <EditText
        android:id="@+id/secondNumberInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/second_number_hint"
        android:inputType="numberDecimal|numberSigned" />

    <!-- Operation buttons in one row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/plusButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="+" />

        <Button
            android:id="@+id/minusButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="-" />

        <Button
            android:id="@+id/multiplyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="*" />

        <Button
            android:id="@+id/divideButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:text="/" />

    </LinearLayout>

    <Button
        android:id="@+id/clearButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:text="@string/clear" />

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/result_empty"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Opens the full calculator (task 2) -->
    <Button
        android:id="@+id/openFullCalculatorButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/open_full_calculator" />

    <!-- Increments MyApp.startCount -->
    <Button
        android:id="@+id/countButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/count" />

    <Button
        android:id="@+id/openSecondButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_second" />

    <Button
        android:id="@+id/openTimerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_timer" />

    <Button
        android:id="@+id/openDiceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_dice" />

    <Button
        android:id="@+id/openDiceCoroutinesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_dice_coroutines" />

    <Button
        android:id="@+id/openCoroutineErrorsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_coroutine_errors" />

    <Button
        android:id="@+id/openDownloadButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_download" />

    <Button
        android:id="@+id/openFlowComparisonButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_flow_comparison" />

    <Button
        android:id="@+id/openBroadcastLogButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_broadcast_log" />

    <Button
        android:id="@+id/openServiceTimerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_service_timer" />

    <Button
        android:id="@+id/openWorkManagerButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_work_manager" />

    <Button
        android:id="@+id/openWaterReminderButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_water_reminder" />

</LinearLayout>

</ScrollView>
